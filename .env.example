# ============================================================================
# LINKEDIN POSTS INTEGRATION - SOCIABLEKIT API
# ============================================================================

# SociableKIT LinkedIn Feed API URL
# Get this from your SociableKIT dashboard: Options > Data feed
# Note: Requires SociableKIT paid plan for API access

VITE_SOCIABLEKIT_FEED_URL=https://data.accentapi.com/feed/YOUR_WIDGET_ID.json

# ============================================================================
# EXISTING ENVIRONMENT VARIABLES
# ============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Referrals (free week of Ignite Insider for profile-page signups)
# REFERRAL_MONTHLY_CAP is duplicated as v_cap in qualify_referral_on_lesson()
# — see migrations/add_referrals.sql. Change both together.
REFERRAL_WEEK_DAYS=7
REFERRAL_MONTHLY_CAP=10
REFERRAL_SIGNUP_WINDOW_MINUTES=30
REFERRAL_IP_DAILY_CAP=3

# ElevenLabs Text-to-Speech
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# The voice every narration is generated in — lessons and blog posts alike.
# Optional: server.js falls back to the current narration voice when unset.
# Voices from the ElevenLabs Voice Library (as opposed to the premade set)
# require a paid plan to use via the API.
# After changing this, existing audio keeps the old voice until rebuilt:
#   node scripts/renarrate-lessons.mjs --dry-run
ELEVENLABS_NARRATION_VOICE_ID=

# Legacy. Only feeds the two unused /api/text-to-speech endpoints; it has never
# affected lesson or blog narration.
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# Resend (Email)
RESEND_API_KEY=your_resend_api_key

# Resend Audience Segmentation
# Create these 3 audiences in your Resend dashboard
# General: Users signed up but no enrolled course
# PM Free: PM course enrolled, not paying
# PM Paid: PM course enrolled, paying
RESEND_AUDIENCE_GENERAL=
RESEND_AUDIENCE_PM_FREE=
RESEND_AUDIENCE_PM_PAID=
VITE_RESEND_AUDIENCE_GENERAL=
VITE_RESEND_AUDIENCE_PM_FREE=
VITE_RESEND_AUDIENCE_PM_PAID=

# Google One-Tap Sign-In
# Get from Google Cloud Console > APIs & Services > Credentials
# Also add this Client ID to Supabase Dashboard > Auth > Google Provider > Authorized Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# API URL
# Requires `npm run server` (Express on 3001). To skip running it locally, override in
# .env.local with VITE_API_URL=https://ignite-education-api.onrender.com
VITE_API_URL=http://localhost:3001

# Server Port
PORT=3001

# ============================================================================
# Job Board (server/jobs/)
# ============================================================================
# The four ATS sources (Greenhouse, Lever, Ashby, Workable) need NO keys — their
# job-board endpoints are public, unauthenticated GETs. Companies to poll are
# rows in job_source_accounts, managed from the admin app.

# Adzuna was removed. Its free API is conditional on a "Jobs by Adzuna" badge at
# >=116x23px on every displayed advert, and we do not want that on the board —
# so the source went rather than the attribution. See
# migrations/remove_adzuna_source.sql for what it cost.
#
# Reed below carries the same kind of obligation ("Powered by reed.co.uk"), so
# it is not a drop-in replacement. Every ATS source requires no attribution at
# all, which is the real distinction: a direct employer feed is ours to display,
# syndicated inventory is not.

# Reed.co.uk — not self-serve; needs a recruiter account and contacting Reed.
# Used as HTTP Basic username with a blank password.
REED_API_KEY=

# How old a posting may be, by its posted_at, before it drops off the board. The
# ingest refuses anything older and the nightly sweep expires what it already
# holds. Defaults to 21 in server/jobs/lib/expire.js.
#
# next-app applies the same cut at read time from its own constant in
# src/data/jobsData.ts, which this variable does NOT reach — they are separate
# deploys. Change both together. If they do drift the tighter one wins, which is
# why the duplication is tolerable: no listing can leak past either.
#
# Read the comment on MAX_POSTED_AGE_DAYS in expire.js before changing this. On
# ATS feeds posted_at is the requisition's creation date, not the advert's, so
# this removes evergreen roles that are genuinely still open.
#
# Measured across all enabled boards, counting only jobs that already pass the
# profession and market filters: 21d → 20, 30d → 37, 45d → 45, 60d → 48,
# 90d → 49, no cut → 67. Set to 45 because that is where the curve flattens.
#
# Widening this does NOT restore already-expired rows — persistBatch never
# rewrites `status`. See migrations/revive_jobs_for_45_day_window.sql.
JOBS_MAX_POSTED_AGE_DAYS=45

# Set to "false" to make the ingest cron a no-op without touching Render config.
JOBS_INGEST_ENABLED=true
# Wall-clock budget per ingest run. Render's free plan can kill long runs, so the
# orchestrator closes the run as `partial` on hitting this rather than dying.
# A request may override it with {"maxSeconds": N} — the enterprise ATS cron
# sends 420, because it pages AND fetches a description per job.
JOBS_INGEST_MAX_SECONDS=240
# Ceiling on per-job description fetches per run, for the two-phase sources
# (Workday, Oracle Recruiting Cloud, JSON-LD careers sites) whose list responses
# carry no advert text.
#
# This is a backstop, not the normal operating point. Jobs we already hold read
# their description from the database, and the title, age and profession gates
# run before any fetch, so a settled board costs a handful of requests a night.
# Anything over the line is dropped as `not_hydrated` and picked up next run —
# it is never persisted with an empty description, which would blank the text of
# a listing we already had.
JOBS_MAX_DETAIL_FETCHES=150
# Set to "false" to make the summaries cron a no-op. Separate from the ingest
# switch on purpose: this one spends Anthropic quota, so it is the one you reach
# for to stop the meter without also stopping the board being refreshed.
JOBS_SUMMARIES_ENABLED=true
# Which model writes the card summaries. Defaults to claude-haiku-4-5 in code.
# Measured on a 12-listing sample, Sonnet 5 completes the "Requires ..." half of
# the summary on 9 listings in 11 against Haiku's 6, for a few pence more across
# the whole board. Anything from the 4.6 generation onward is fine — the caller
# drops `temperature` for those, since they reject it with a 400.
JOBS_SUMMARY_MODEL=claude-sonnet-5
# Per-user daily cap on apply-link resolutions (GET /api/jobs/:id/apply).
JOBS_APPLY_DAILY_CAP=200
# Guess a company's website from its name when there is no curated domain, in
# order to look up a logo. OFF by default, and deliberately: measured against the
# live board it picked the WRONG COMPANY for 8 of 25 (harvey.co.uk is a
# water-softener firm, not the legal-AI company). Only enable if you intend to
# review the resolved domains in the admin Companies tab.
JOBS_LOGO_GUESS_DOMAINS=false
# Only ingest jobs from companies flagged `allowed` in job_companies. ON by
# default, and this is the single most important switch on the board: it is what
# makes job_companies the source of truth for whose roles are shown. Set to
# "false" to fall back to blocklist-only behaviour (ingest everything except
# companies with trust = 'blocked'). With allowlist mode on and an empty
# allowlist, the ingest fails loudly rather than opening up.
#
# Being allowed is only half of it. A company also needs something FETCHING its
# jobs — a job_source_accounts board or a job_queries company sweep. The admin
# Coverage tab exists to show which allowed companies have neither.
JOBS_COMPANY_ALLOWLIST=true

# Shared secret for cron-triggered endpoints (/api/cron/aggregate-memory,
# /api/cron/ingest-jobs). Must match the value set on the Render cron services.
CRON_SECRET=
